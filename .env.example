# Нэвтрэх эрх. data/db.json-д хэрэглэгч байхгүй үед л анхны нууц үгээр ашиглагдана (хоосон бол admin123 / saran123).
ADMIN_PASSWORD=
USER_PASSWORD=
# White Queen станцын эрх (ирц, гэрэл, хоолойн мэдэгдэл). Анх үүсэхэд л ашиглагдана (хоосон бол whiteking123).
WHITEQUEEN_PASSWORD=
# Red King-ийн хоолой: ElevenLabs (түлхүүр байвал эхэлж ашиглана). Хоосон бол Bilguun (KQhNCZcXa4AKEt3GoAdo), eleven_v4 → eleven_v3.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
# Станцын эмэгтэй хоолой (хоосон бол ElevenLabs: Matilda XrExE9yKIg1WjnnlVkGX, OpenAI: nova, Gemini: Kore).
ELEVENLABS_QUEEN_VOICE=
OPENAI_QUEEN_VOICE=
GEMINI_QUEEN_VOICE=

# Firebase Firestore өгөгдлийн сан. Хоосон бол data/db.json дотоод файлд хадгална.
# Firebase Console → Project settings → Service accounts → "Generate new private key" товчоор татсан JSON-ийг
# төслийн хавтаст firebase-service-account.json нэрээр хадгална (.gitignore-д орсон, хөтөч рүү хэзээ ч илгээгдэхгүй).
FIREBASE_SERVICE_ACCOUNT_FILE=
# Заавал биш: олон Firestore өгөгдлийн сантай бол нэр нь (хоосон бол "(default)")
# FIREBASE_DATABASE_ID=

# Red King AI туслах. Аль нэгийг нь ч гэсэн бөглөхөд холбогдоно; бүгд хоосон бол дотоод чиглүүлэгч хариулна.
# Google AI Studio (Gemini). Дуу таних, дуу гаргахад мөн ашиглана.
GEMINI_API_KEY=
# Anthropic Console (Claude)
ANTHROPIC_API_KEY=
# OpenAI Platform (ChatGPT). Дуу таних (gpt-transcribe), дуу гаргахад (gpt-4o-mini-tts) мөн ашиглана.
OPENAI_API_KEY=
# xAI Console (Grok)
XAI_API_KEY=
# «Автомат» горимд эхэлж асуух AI: gemini, claude, openai, grok
AI_DEFAULT=

# Заавал биш: загвар (таслалаар нөөц загвар нэмж болно)
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_STT_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# ANTHROPIC_MODEL=claude-sonnet-5-5,claude-haiku-5-5
# OPENAI_MODEL=gpt-6.1-terra,gpt-5.4-mini
# XAI_MODEL=grok-4.7,grok-4.6
# Заавал биш: дуу хоолой
# TTS_PROVIDER=openai
# OPENAI_TTS_VOICE=onyx
# GEMINI_TTS_VOICE=Charon

# OpenWeatherMap. Цаг агаарын 3D газрын зургийн давхаргууд (температур, хур тунадас, үүл, салхи, даралт).
# Шинэ түлхүүр идэвхжихэд 2 цаг хүртэл хугацаа ордог.
OPENWEATHERMAP_API_KEY=

# Цаг агаар: NOAA GFS 0.25° (түлхүүргүй, Zoom Earth-ийн model=gfs-тэй ижил загвар).
# Зөвхөн энэ бүсийг (баруун,урд,зүүн,хойд градус) 6 цаг тутам татаж data/gfs-д хадгална.
GFS_BBOX=70,33,135,60

# 3D газрын барилга: Overture Maps (OSM + Microsoft/Google ML footprint, өндөртэй). Хоосон бол 2026-10-21.0 хувилбар.
# Шинэ хувилбар: https://docs.overturemaps.org/examples/overture-tiles/
OVERTURE_BUILDINGS_URL=

# Google Maps. Хоосон бол газар, зам OpenStreetMap + OSRM (түгжрэлгүй минут).
GOOGLE_MAPS_API_KEY=
# Optional: separate referrer-restricted key for the browser 3D map (Maps JavaScript API + Places API (New)).
# Falls back to GOOGLE_MAPS_API_KEY when empty.
GOOGLE_MAPS_BROWSER_KEY=
# Замын түгжрэлийн давхарга (бүх газрын зураг): Google Cloud дээр "Map Tiles API" идэвхжүүлсэн, billing-тэй серверийн түлхүүр.
# Сард 100,000 тайл үнэгүй. Хоосон бол GOOGLE_MAPS_API_KEY-г ашиглана. Хөтөч рүү хэзээ ч илгээгдэхгүй.
GOOGLE_TILES_API_KEY=

# Amadeus нислэгийн хуваарь. Хоосон бол цаг, үнэ зохиохгүй.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test эсвэл production
AMADEUS_HOST=test